# ============================================================
#  .htaccess — кеш и безопасность
# ============================================================

# Главная страница — index.php (с авторизацией), затем index.html
DirectoryIndex index.php index.html

# Отключить кеш для JS, CSS и JSON (файлы проекта)
<FilesMatch "\.(js|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Запретить прямой веб-доступ к служебным PHP-файлам авторизации
<FilesMatch "^(config\.php|config\.example\.php|db\.php|functions\.php)$">
    Require all denied
</FilesMatch>

# Запретить доступ к .sql и прочим служебным файлам
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Прямой запрос index.html → редирект на index.php (чтобы не обходить вход)
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^ index.php [R=302,L]

    # Полностью закрыть папку планировщика от веба
    RewriteRule ^auth/cron/ - [F,L]
</IfModule>
