# ============================================================
#  catalog/.htaccess — защита служебных файлов модуля каталога
# ============================================================

# tiles.json / filters.json читаются сервером (index.php внедряет их в страницу),
# прямой веб-доступ не нужен — закрываем.
<FilesMatch "\.(json)$">
    Require all denied
</FilesMatch>

# Бизнес-логика модуля — не для прямого вызова.
<FilesMatch "^functions\.php$">
    Require all denied
</FilesMatch>
